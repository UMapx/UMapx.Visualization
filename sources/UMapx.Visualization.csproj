<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <Version>8.0.0.3</Version>
	<AssemblyVersion>8.0.0.3</AssemblyVersion>
	<FileVersion>8.0.0.3</FileVersion>
    <AssemblyName>UMapx.Visualization</AssemblyName>
    <RootNamespace>UMapx.Visualization</RootNamespace>
    <PackageId>UMapx.Visualization</PackageId>
    <Company>Valery Asiryan</Company>
    <Authors>Valery Asiryan</Authors>
    <Product>UMapx.Visualization</Product>
    <Copyright>Valery Asiryan, © 2015-2026</Copyright>
    <Description>UMapx sub-library for plotting data on Windows.</Description>
    <PackageProjectUrl>https://github.com/UMapx/UMapx.Visualization</PackageProjectUrl>
    <RepositoryUrl>https://github.com/UMapx/UMapx.Visualization</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>visualization plotting charts graphics bitmap annotations</PackageTags>
    <NeutralLanguage>en</NeutralLanguage>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageIcon>umapxnet.png</PackageIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
	<Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.1" />
    <ProjectReference Include="../../UMapx/sources/UMapx.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="LICENSE.md">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="umapxnet.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

</Project>
